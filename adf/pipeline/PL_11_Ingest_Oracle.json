{
    "name": "PL_11_Ingest_Oracle",
    "properties": {
        "description": "Oracle ERP. ORACLE_WATERMARK: LAST_UPDATE_DATE window frozen at start. ORACLE_FULL: whole table (has_changes always 1). Same count/validate/publish/watermark contract as every source.",
        "activities": [
            {
                "name": "Get_High_Watermark",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 120,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "OracleSource",
                        "oracleReaderQuery": {
                            "value": "@if(empty(pipeline().parameters.entity.hwm_query), 'SELECT NULL AS HWM FROM DUAL', pipeline().parameters.entity.hwm_query)",
                            "type": "Expression"
                        },
                        "queryTimeout": "00:30:00"
                    },
                    "dataset": {
                        "referenceName": "DS_Oracle_ERP",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "Start_Run",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "Get_High_Watermark",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderStoredProcedureName": "[ctl].[usp_start_ingestion_run]",
                        "storedProcedureParameters": {
                            "entity_id": {
                                "type": "Int32",
                                "value": {
                                    "value": "@pipeline().parameters.entity.entity_id",
                                    "type": "Expression"
                                }
                            },
                            "batch_run_id": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.batch_run_id",
                                    "type": "Expression"
                                }
                            },
                            "adf_pipeline_run_id": {
                                "type": "String",
                                "value": {
                                    "value": "@pipeline().RunId",
                                    "type": "Expression"
                                }
                            },
                            "load_date": {
                                "type": "DateTime",
                                "value": {
                                    "value": "@pipeline().parameters.run_date",
                                    "type": "Expression"
                                }
                            },
                            "candidate_window_end": {
                                "type": "String",
                                "value": {
                                    "value": "@coalesce(activity('Get_High_Watermark').output.firstRow?.HWM, '')",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:10:00"
                    },
                    "dataset": {
                        "referenceName": "DS_ControlDB",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "If_Has_Changes",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Start_Run",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@bool(activity('Start_Run').output.firstRow.has_changes)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Get_Source_Count",
                            "type": "Lookup",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:30:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "OracleSource",
                                    "oracleReaderQuery": {
                                        "value": "@activity('Start_Run').output.firstRow.count_query",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "00:30:00"
                                },
                                "dataset": {
                                    "referenceName": "DS_Oracle_ERP",
                                    "type": "DatasetReference"
                                },
                                "firstRowOnly": true
                            }
                        },
                        {
                            "name": "Copy_To_Staging",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Get_Source_Count",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.04:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [
                                {
                                    "name": "entity",
                                    "value": {
                                        "value": "@pipeline().parameters.entity.entity_name",
                                        "type": "Expression"
                                    }
                                },
                                {
                                    "name": "run_id",
                                    "value": {
                                        "value": "@activity('Start_Run').output.firstRow.run_id",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "typeProperties": {
                                "source": {
                                    "type": "OracleSource",
                                    "oracleReaderQuery": {
                                        "value": "@activity('Start_Run').output.firstRow.source_query",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "parallelCopies": 4
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_Oracle_ERP",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@concat('_staging/', activity('Start_Run').output.firstRow.target_path)",
                                            "type": "Expression"
                                        },
                                        "file": {
                                            "value": "@concat(activity('Start_Run').output.firstRow.run_id, '.parquet')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Validate_Counts",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Copy_To_Staging",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_validate_ingestion_counts]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "source_count": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@activity('Get_Source_Count').output.firstRow.SOURCE_COUNT",
                                            "type": "Expression"
                                        }
                                    },
                                    "rows_read": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@activity('Copy_To_Staging').output.rowsRead",
                                            "type": "Expression"
                                        }
                                    },
                                    "rows_copied": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@activity('Copy_To_Staging').output.rowsCopied",
                                            "type": "Expression"
                                        }
                                    },
                                    "rows_skipped": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@coalesce(activity('Copy_To_Staging').output.rowsSkipped, 0)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Publish_Staging_To_Raw",
                            "description": "Move validated files from _staging to the path Auto Loader watches. Same run_id => same path => a retry overwrites instead of duplicating.",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Validate_Counts",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "deleteFilesAfterCompletion": true
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings",
                                        "copyBehavior": "PreserveHierarchy"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@concat('_staging/', activity('Start_Run').output.firstRow.target_path)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@activity('Start_Run').output.firstRow.target_path",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Write_Manifest",
                            "description": "Row-count manifest consumed by Databricks ADF_TO_BRONZE reconciliation.",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Publish_Staging_To_Raw",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "@concat('SELECT * FROM ctl.vw_run_manifest WHERE run_id = ''', activity('Start_Run').output.firstRow.run_id, '''')",
                                        "type": "Expression"
                                    }
                                },
                                "sink": {
                                    "type": "JsonSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "JsonWriteSettings",
                                        "filePattern": "setOfObjects"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_ControlDB",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Json",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@concat('_manifests/', pipeline().parameters.entity.entity_name)",
                                            "type": "Expression"
                                        },
                                        "file": {
                                            "value": "@concat(activity('Start_Run').output.firstRow.run_id, '.json')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Complete_Run_Advance_Watermark",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Write_Manifest",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_complete_ingestion_run]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "no_changes": {
                                        "type": "Boolean",
                                        "value": "false"
                                    }
                                }
                            }
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "Complete_Run_No_Changes",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_complete_ingestion_run]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "no_changes": {
                                        "type": "Boolean",
                                        "value": "true"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Log_Run_Failure",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "If_Has_Changes",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_AzureSql_ControlDB",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_fail_ingestion_run]",
                    "storedProcedureParameters": {
                        "run_id": {
                            "type": "String",
                            "value": {
                                "value": "@activity('Start_Run').output.firstRow.run_id",
                                "type": "Expression"
                            }
                        },
                        "error_message": {
                            "type": "String",
                            "value": {
                                "value": "@activity('If_Has_Changes').error.message",
                                "type": "Expression"
                            }
                        }
                    }
                }
            },
            {
                "name": "Send_Failure_Alert",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "Log_Run_Failure",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_90_Send_Alert",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "severity": {
                            "value": "@pipeline().parameters.entity.alert_severity",
                            "type": "Expression"
                        },
                        "pipeline_name": {
                            "value": "@pipeline().Pipeline",
                            "type": "Expression"
                        },
                        "entity_name": {
                            "value": "@pipeline().parameters.entity.entity_name",
                            "type": "Expression"
                        },
                        "message": {
                            "value": "@activity('If_Has_Changes').error.message",
                            "type": "Expression"
                        },
                        "adf_run_id": {
                            "value": "@pipeline().RunId",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "Fail_Pipeline",
                "type": "Fail",
                "dependsOn": [
                    {
                        "activity": "Send_Failure_Alert",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "message": {
                        "value": "@concat('Ingestion failed for ', pipeline().parameters.entity.entity_name, ' run ', activity('Start_Run').output.firstRow.run_id, ': ', activity('If_Has_Changes').error.message)",
                        "type": "Expression"
                    },
                    "errorCode": "INGESTION_FAILED"
                }
            }
        ],
        "parameters": {
            "entity": {
                "type": "object"
            },
            "batch_run_id": {
                "type": "string"
            },
            "run_date": {
                "type": "string"
            }
        },
        "folder": {
            "name": "10_Ingestion"
        },
        "annotations": [
            "ingestion"
        ]
    }
}
