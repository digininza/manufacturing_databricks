{
    "name": "PL_13_Ingest_ADLS_Files",
    "properties": {
        "description": "Supplier CSV files on ADLS landing: LastModified window -> list+audit files -> CSV->parquet with skip-and-log fault tolerance -> validate (reject %) -> publish -> manifest -> watermark -> archive.",
        "activities": [
            {
                "name": "Start_Run",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderStoredProcedureName": "[ctl].[usp_start_ingestion_run]",
                        "storedProcedureParameters": {
                            "entity_id": {
                                "type": "Int32",
                                "value": {
                                    "value": "@pipeline().parameters.entity.entity_id",
                                    "type": "Expression"
                                }
                            },
                            "batch_run_id": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.batch_run_id",
                                    "type": "Expression"
                                }
                            },
                            "adf_pipeline_run_id": {
                                "type": "String",
                                "value": {
                                    "value": "@pipeline().RunId",
                                    "type": "Expression"
                                }
                            },
                            "load_date": {
                                "type": "DateTime",
                                "value": {
                                    "value": "@pipeline().parameters.run_date",
                                    "type": "Expression"
                                }
                            },
                            "candidate_window_end": {
                                "type": "String",
                                "value": {
                                    "value": "@utcNow('yyyy-MM-ddTHH:mm:ssZ')",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:10:00"
                    },
                    "dataset": {
                        "referenceName": "DS_ControlDB",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "If_Has_Changes",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Start_Run",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@bool(activity('Start_Run').output.firstRow.has_changes)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "List_Landing_Files",
                            "type": "GetMetadata",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataset": {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "landing",
                                        "folder": {
                                            "value": "@pipeline().parameters.entity.landing_folder",
                                            "type": "Expression"
                                        }
                                    }
                                },
                                "fieldList": [
                                    "childItems",
                                    "itemCount"
                                ],
                                "storeSettings": {
                                    "type": "AzureBlobFSReadSettings",
                                    "recursive": false,
                                    "modifiedDatetimeStart": {
                                        "value": "@activity('Start_Run').output.firstRow.window_start",
                                        "type": "Expression"
                                    },
                                    "modifiedDatetimeEnd": {
                                        "value": "@activity('Start_Run').output.firstRow.window_end",
                                        "type": "Expression"
                                    }
                                },
                                "formatSettings": {
                                    "type": "BinaryReadSettings"
                                }
                            }
                        },
                        {
                            "name": "Audit_File_List",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "List_Landing_Files",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_log_audit]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "entity_name": {
                                        "type": "String",
                                        "value": {
                                            "value": "@pipeline().parameters.entity.entity_name",
                                            "type": "Expression"
                                        }
                                    },
                                    "event_type": {
                                        "type": "String",
                                        "value": "FILES_DETECTED"
                                    },
                                    "event_detail": {
                                        "type": "String",
                                        "value": {
                                            "value": "@string(activity('List_Landing_Files').output.childItems)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Copy_To_Staging",
                            "description": "CSV -> parquet. Fault tolerance: malformed rows are SKIPPED and logged to raw/_rejected/, then Validate_Counts enforces max_reject_pct.",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Audit_File_List",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [
                                {
                                    "name": "entity",
                                    "value": {
                                        "value": "@pipeline().parameters.entity.entity_name",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": false,
                                        "wildcardFolderPath": {
                                            "value": "@pipeline().parameters.entity.landing_folder",
                                            "type": "Expression"
                                        },
                                        "wildcardFileName": {
                                            "value": "@pipeline().parameters.entity.file_pattern",
                                            "type": "Expression"
                                        },
                                        "modifiedDatetimeStart": {
                                            "value": "@activity('Start_Run').output.firstRow.window_start",
                                            "type": "Expression"
                                        },
                                        "modifiedDatetimeEnd": {
                                            "value": "@activity('Start_Run').output.firstRow.window_end",
                                            "type": "Expression"
                                        },
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextReadSettings",
                                        "skipLineCount": 0
                                    },
                                    "additionalColumns": [
                                        {
                                            "name": "_landing_file_name",
                                            "value": "$$FILEPATH"
                                        }
                                    ]
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "enableSkipIncompatibleRow": true,
                                "logSettings": {
                                    "enableCopyActivityLog": true,
                                    "copyActivityLogSettings": {
                                        "logLevel": "Warning",
                                        "enableReliableLogging": true
                                    },
                                    "logLocationSettings": {
                                        "linkedServiceName": {
                                            "referenceName": "LS_ADLS_Gen2",
                                            "type": "LinkedServiceReference"
                                        },
                                        "path": {
                                            "value": "@concat('raw/_rejected/', pipeline().parameters.entity.entity_name, '/', activity('Start_Run').output.firstRow.run_id)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_ADLS_Csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "landing",
                                        "folder": {
                                            "value": "@pipeline().parameters.entity.landing_folder",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@concat('_staging/', activity('Start_Run').output.firstRow.target_path)",
                                            "type": "Expression"
                                        },
                                        "file": {
                                            "value": "@concat(activity('Start_Run').output.firstRow.run_id, '.parquet')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Validate_Counts",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Copy_To_Staging",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_validate_ingestion_counts]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "source_count": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@int(-1)",
                                            "type": "Expression"
                                        }
                                    },
                                    "rows_read": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@activity('Copy_To_Staging').output.rowsRead",
                                            "type": "Expression"
                                        }
                                    },
                                    "rows_copied": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@activity('Copy_To_Staging').output.rowsCopied",
                                            "type": "Expression"
                                        }
                                    },
                                    "rows_skipped": {
                                        "type": "Int64",
                                        "value": {
                                            "value": "@coalesce(activity('Copy_To_Staging').output.rowsSkipped, 0)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Publish_Staging_To_Raw",
                            "description": "Move validated files from _staging to the path Auto Loader watches. Same run_id => same path => a retry overwrites instead of duplicating.",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Validate_Counts",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "deleteFilesAfterCompletion": true
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings",
                                        "copyBehavior": "PreserveHierarchy"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@concat('_staging/', activity('Start_Run').output.firstRow.target_path)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@activity('Start_Run').output.firstRow.target_path",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Write_Manifest",
                            "description": "Row-count manifest consumed by Databricks ADF_TO_BRONZE reconciliation.",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Publish_Staging_To_Raw",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "@concat('SELECT * FROM ctl.vw_run_manifest WHERE run_id = ''', activity('Start_Run').output.firstRow.run_id, '''')",
                                        "type": "Expression"
                                    }
                                },
                                "sink": {
                                    "type": "JsonSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "JsonWriteSettings",
                                        "filePattern": "setOfObjects"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_ControlDB",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Json",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": {
                                            "value": "@pipeline().parameters.entity.target_container",
                                            "type": "Expression"
                                        },
                                        "folder": {
                                            "value": "@concat('_manifests/', pipeline().parameters.entity.entity_name)",
                                            "type": "Expression"
                                        },
                                        "file": {
                                            "value": "@concat(activity('Start_Run').output.firstRow.run_id, '.json')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "Complete_Run_Advance_Watermark",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Write_Manifest",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_complete_ingestion_run]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "no_changes": {
                                        "type": "Boolean",
                                        "value": "false"
                                    }
                                }
                            }
                        },
                        {
                            "name": "Archive_Landing_Files",
                            "description": "Move processed files landing/<folder>/incoming -> archive (copy + delete source). Runs AFTER the watermark moved: a failure here never causes re-ingestion.",
                            "type": "Copy",
                            "dependsOn": [
                                {
                                    "activity": "Complete_Run_Advance_Watermark",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.01:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 120,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": false,
                                        "wildcardFileName": {
                                            "value": "@pipeline().parameters.entity.file_pattern",
                                            "type": "Expression"
                                        },
                                        "modifiedDatetimeStart": {
                                            "value": "@activity('Start_Run').output.firstRow.window_start",
                                            "type": "Expression"
                                        },
                                        "modifiedDatetimeEnd": {
                                            "value": "@activity('Start_Run').output.firstRow.window_end",
                                            "type": "Expression"
                                        },
                                        "deleteFilesAfterCompletion": true
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "landing",
                                        "folder": {
                                            "value": "@pipeline().parameters.entity.landing_folder",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Binary",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "landing",
                                        "folder": {
                                            "value": "@concat(replace(pipeline().parameters.entity.landing_folder, '/incoming', '/archive'), '/', pipeline().parameters.run_date)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "Complete_Run_No_Changes",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_AzureSql_ControlDB",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "[ctl].[usp_complete_ingestion_run]",
                                "storedProcedureParameters": {
                                    "run_id": {
                                        "type": "String",
                                        "value": {
                                            "value": "@activity('Start_Run').output.firstRow.run_id",
                                            "type": "Expression"
                                        }
                                    },
                                    "no_changes": {
                                        "type": "Boolean",
                                        "value": "true"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Log_Run_Failure",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "If_Has_Changes",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_AzureSql_ControlDB",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_fail_ingestion_run]",
                    "storedProcedureParameters": {
                        "run_id": {
                            "type": "String",
                            "value": {
                                "value": "@activity('Start_Run').output.firstRow.run_id",
                                "type": "Expression"
                            }
                        },
                        "error_message": {
                            "type": "String",
                            "value": {
                                "value": "@activity('If_Has_Changes').error.message",
                                "type": "Expression"
                            }
                        }
                    }
                }
            },
            {
                "name": "Send_Failure_Alert",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "Log_Run_Failure",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_90_Send_Alert",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "severity": {
                            "value": "@pipeline().parameters.entity.alert_severity",
                            "type": "Expression"
                        },
                        "pipeline_name": {
                            "value": "@pipeline().Pipeline",
                            "type": "Expression"
                        },
                        "entity_name": {
                            "value": "@pipeline().parameters.entity.entity_name",
                            "type": "Expression"
                        },
                        "message": {
                            "value": "@activity('If_Has_Changes').error.message",
                            "type": "Expression"
                        },
                        "adf_run_id": {
                            "value": "@pipeline().RunId",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "Fail_Pipeline",
                "type": "Fail",
                "dependsOn": [
                    {
                        "activity": "Send_Failure_Alert",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "message": {
                        "value": "@concat('Ingestion failed for ', pipeline().parameters.entity.entity_name, ' run ', activity('Start_Run').output.firstRow.run_id, ': ', activity('If_Has_Changes').error.message)",
                        "type": "Expression"
                    },
                    "errorCode": "INGESTION_FAILED"
                }
            }
        ],
        "parameters": {
            "entity": {
                "type": "object"
            },
            "batch_run_id": {
                "type": "string"
            },
            "run_date": {
                "type": "string"
            }
        },
        "folder": {
            "name": "10_Ingestion"
        },
        "annotations": [
            "ingestion"
        ]
    }
}
