								},
								{
									"value": "ADLS_FILE",
									"activities": [
										{
											"name": "Run_ADLS_Files",
											"type": "ExecutePipeline",
											"dependsOn": [],
											"policy": {
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"pipeline": {
													"referenceName": "PL_13_Ingest_ADLS_Files",
													"type": "PipelineReference"
												},
												"waitOnCompletion": true,
												"parameters": {
													"entity": {
														"value": "@pipeline().parameters.entity",
														"type": "Expression"
													},
													"batch_run_id": {
														"value": "@pipeline().parameters.batch_run_id",
														"type": "Expression"
													},
