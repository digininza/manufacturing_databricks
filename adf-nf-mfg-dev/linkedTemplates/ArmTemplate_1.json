											"type": "ExecutePipeline",
											"dependsOn": [],
											"policy": {
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"pipeline": {
													"referenceName": "PL_12_Ingest_RestApi",
													"type": "PipelineReference"
												},
												"waitOnCompletion": true,
												"parameters": {
													"entity": {
														"value": "@pipeline().parameters.entity",
														"type": "Expression"
													},
													"batch_run_id": {
														"value": "@pipeline().parameters.batch_run_id",
														"type": "Expression"
													},
													"run_date": {
														"value": "@pipeline().parameters.run_date",
														"type": "Expression"
													}
